e=wrap;html=0;fillColor=#EAF3FA;strokeColor=#608EB0;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="350" y="157" width="390" height="42" as="geometry" /></mxCell><mxCell id="n4" value="橙：文言・事実の変更" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFF1E3;strokeColor=#C88C4A;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=16;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="780" y="157" width="390" height="42" as="geometry" /></mxCell><mxCell id="n5" value="現サイト  |  m-ap.net" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="680" height="36" as="geometry" /></mxCell><mxCell id="n6" value="更新案  |  現サイトをベースに調整" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="860" y="210" width="680" height="36" as="geometry" /></mxCell><mxCell id="n7" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="282" width="680" height="447" as="geometry" /></mxCell><mxCell id="n8" value="A  m-apについて /about/" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="298" width="640" height="34" as="geometry" /></mxCell><mxCell id="n9" value="物件・お金・設計を、&#10;ひとつの住まいとして考える。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=27;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="345" width="632" height="90" as="geometry" /></mxCell><mxCell id="n10" value="自分でも中古マンションを購入。&#10;予算・設計・暮らしを一緒に考えてきた経験。&#10;資格、一緒に考える姿勢、5つの大切にすること。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3F4F2;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=20;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="460" width="632" height="120" as="geometry" /></mxCell><mxCell id="n11" value="自邸の経験・資格・大切にすること・相談へのリンクは維持。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="654" width="632" height="54" as="geometry" /></mxCell><mxCell id="n12" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="860" y="282" width="680" height="447" as="geometry" /></mxCell><mxCell id="n13" value="A  m-apについて /about/" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="880" y="298" width="640" height="34" as="geometry" /></mxCell><mxCell id="n14" value="建築の視点から、&#10;場所とその使い方を考える。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFF1E3;strokeColor=#C88C4A;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=27;fontStyle=1;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="345" width="632" height="89" as="geometry" /></mxCell><mxCell id="n15" value="m-apは、人の思いや場所の条件を読み解き、&#10;課題を整理して、具体的なかたちにつなげます。&#10;住まい、働く場所、既存建物の活用など、&#10;何をつくるかが決まる前から一緒に考えます。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EAF3FA;strokeColor=#608EB0;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=20;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="460" width="632" height="171" as="geometry" /></mxCell><mxCell id="n16" value="自邸の経験・資格・大切にすること・相談へのリンクは維持。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="654" width="632" height="54" as="geometry" /></mxCell><mxCell id="n17" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="759" width="680" height="492" as="geometry" /></mxCell><mxCell id="n18" value="B  相談できること /services/" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="775" width="640" height="34" as="geometry" /></mxCell><mxCell id="n19" value="探す前 → 買う前 → 設計 → 工事&#10;住宅相談の段階別説明・料金の考え方" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3F4F2;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="823" width="632" height="92" as="geometry" /></mxCell><mxCell id="n20" value="末尾の一文：&#10;住宅以外のご相談も、初回に対応できる範囲を確認します。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="942" width="632" height="81" as="geometry" /></mxCell><UserObject id="n21" label="無料の初回相談を申し込む" link="https://m-ap.net/contact/" linkTarget="_blank"><mxCell style="rounded=0;whiteSpace=wrap;html=0;fillColor=#253D4A;strokeColor=#253D4A;fontColor=#FFFFFF;fontFamily=Noto Sans CJK JP;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="1186" width="380" height="44" as="geometry" /></mxCell></UserObject><mxCell id="n22" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="860" y="759" width="680" height="492" as="geometry" /></mxCell><mxCell id="n23" value="B  相談できること /services/" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="880" y="775" width="640" height="34" as="geometry" /></mxCell><mxCell id="n24" value="探す前 → 買う前 → 設計 → 工事&#10;住宅相談の段階別説明・料金の考え方" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3F4F2;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="823" width="632" height="92" as="geometry" /></mxCell><mxCell id="n25" value="住まい以外のことも。&#10;&#10;オフィスや店舗の改修、既存建物の活用なども&#10;ご相談ください。実現したいことや、今困っている&#10;ことから、対応できる範囲を一緒に整理します。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#EAF3FA;strokeColor=#608EB0;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=21;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="938" width="632" height="228" as="geometry" /></mxCell><UserObject id="n26" label="無料の初回相談を申し込む" link="https://m-ap.net/contact/" linkTarget="_blank"><mxCell style="rounded=0;whiteSpace=wrap;html=0;fillColor=#253D4A;strokeColor=#253D4A;fontColor=#FFFFFF;fontFamily=Noto Sans CJK JP;fontSize=16;fontStyle=0;align=center;verticalAlign=middle;spacing=10;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="1186" width="380" height="44" as="geometry" /></mxCell></UserObject><mxCell id="n27" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="1281" width="680" height="379" as="geometry" /></mxCell><mxCell id="n28" value="C  実績一覧・自邸詳細" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="80" y="1297" width="640" height="34" as="geometry" /></mxCell><mxCell id="n29" value="/works-page/&#10;/works/machida-renovation/" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="1339" width="632" height="46" as="geometry" /></mxCell><mxCell id="n30" value="既存写真" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EBE8;strokeColor=#C6CCCA;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="1408" width="210" height="135" as="geometry" /></mxCell><mxCell id="n31" value="東京・町田  自邸リノベーション&#10;住宅 / 約70㎡&#10;2024" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3F4F2;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=20;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="320" y="1408" width="396" height="135" as="geometry" /></mxCell><mxCell id="n32" value="現公開サイトの2ページで「2024」の表示あり。&#10;写真・改修前後図面・設計意図・自邸記録へのリンクを掲載。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="1570" width="632" height="62" as="geometry" /></mxCell><mxCell id="n33" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFFFFF;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="860" y="1281" width="680" height="379" as="geometry" /></mxCell><mxCell id="n34" value="C  実績一覧・自邸詳細" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="880" y="1297" width="640" height="34" as="geometry" /></mxCell><mxCell id="n35" value="/works-page/&#10;/works/machida-renovation/" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="1339" width="632" height="46" as="geometry" /></mxCell><mxCell id="n36" value="既存写真" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#E8EBE8;strokeColor=#C6CCCA;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=17;fontStyle=0;align=center;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="1408" width="210" height="135" as="geometry" /></mxCell><mxCell id="n37" value="東京・町田  自邸リノベーション&#10;住宅 / 約70㎡&#10;2025年11月竣工" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#FFF1E3;strokeColor=#C88C4A;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=20;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="1120" y="1408" width="396" height="135" as="geometry" /></mxCell><mxCell id="n38" value="本人確認済みの竣工年月を2ページで統一。&#10;記事の公開・更新日（2026年）とは区別して表示。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="884" y="1570" width="632" height="62" as="geometry" /></mxCell><mxCell id="n39" value="" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#F3F4F2;strokeColor=#CCD1D2;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=18;fontStyle=0;align=left;verticalAlign=middle;spacing=16;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="1690" width="1480" height="309" as="geometry" /></mxCell><mxCell id="n40" value="変更後も残すもの / 確認のしかた" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="1712" width="1428" height="37" as="geometry" /></mxCell><mxCell id="n41" value="1  写真・図面・図説、既存のページ順と住宅相談への主導線を維持します。&#10;2  ABOUTとサービスの追加文案は、m-apの業務範囲の表現として公開前に確認します。&#10;3  トップの変更は「全体像の短い説明」と「自邸リンクの文言」に限定しています。&#10;4  draw.io上では文字・枠・ボタンを個別に編集できます。右列が提案、左列が確認時点の現状です。&#10;5  本図はPCの構造比較です。スマホ実表示・フォーム送信はこの図の確認対象に含みません。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#253741;fontFamily=Noto Sans CJK JP;fontSize=19;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="84" y="1773" width="1408" height="184" as="geometry" /></mxCell><mxCell id="n42" value="出典：現公開サイトを2026年10月10日に確認。&#10;https://m-ap.net/about/  ・  https://m-ap.net/services/&#10;https://m-ap.net/works-page/  ・  https://m-ap.net/works/machida-renovation/&#10;竣工年月の更新根拠：本人の確認（2025年11月）。本図の案は未公開です。" style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;fontColor=#66747A;fontFamily=Noto Sans CJK JP;fontSize=17;fontStyle=0;align=left;verticalAlign=middle;spacing=0;overflow=hidden;" vertex="1" parent="1"><mxGeometry x="60" y="2030" width="1480" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>